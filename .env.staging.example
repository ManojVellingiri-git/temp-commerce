# ========================================================
# Staging Environment Configuration (Docker Compose)
# FreshCart Grocery Application
# ========================================================

# Environment Mode
NODE_ENV=staging
PORT=5001

# Domain / Client URLs (Strict CORS)
CLIENT_URL=https://staging.grocery.local,http://localhost:3000
REACT_APP_API_URL=/api

# Database Configuration (Authenticated & Internal-only)
MONGO_INITDB_ROOT_USERNAME=staging_admin
MONGO_INITDB_ROOT_PASSWORD=replace_with_strong_staging_db_password
MONGODB_URI=mongodb://staging_admin:replace_with_strong_staging_db_password@mongodb:27017/grocery_db?authSource=admin

# JWT Authentication Secret (Must be high-entropy, at least 32 characters)
JWT_SECRET=replace_with_secure_random_staging_jwt_secret_at_least_32_characters

# Razorpay Test Mode Credentials
# IMPORTANT: Provide genuine Test Mode credentials (rzp_test_...) from your Razorpay Dashboard.
# NEVER commit genuine keys to source control.
RAZORPAY_KEY_ID=rzp_test_your_staging_key_id
RAZORPAY_KEY_SECRET=your_staging_key_secret
